# Production Environment Configuration
# Copy this to .env.prod and fill in the values

# PostgreSQL (REQUIRED)
POSTGRES_DB=calculus_rag
POSTGRES_USER=calculus
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# Application
APP_PORT=8501
ENVIRONMENT=production

# Ollama Models (local)
OLLAMA_MODEL=qwen2-math:1.5b
# Use qwen2-math:7b if server has 16GB+ RAM

# Cloud LLM (Optional - for complex questions)
# Requires: docker exec -it calculus_rag_ollama_prod ollama signin
CLOUD_LLM_ENABLED=true
CLOUD_LLM_PROVIDER=ollama-cloud
CLOUD_LLM_MODEL=deepseek-v3.1:671b-cloud

# Available cloud models (pull with: docker exec calculus_rag_ollama_prod ollama pull <model>):
# - deepseek-v3.1:671b-cloud   (fast, good quality - recommended)
# - deepseek-v3.2:cloud        (latest DeepSeek, 671B params)
# - gpt-oss:120b-cloud         (best explanations for students)
# - devstral-2:123b-cloud      (code-specialized)
# - qwen3-vl:235b-cloud        (vision - can process images)
